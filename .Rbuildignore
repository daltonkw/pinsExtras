^pins-extras\.Rproj$
^\.Rproj\.user$
^\.Rhistory$
^\.RData$
^\.DS_Store$
^LICENSE\.md$
^\.cache/
^scripts/
^rv/
^rv\.lock$
^rproject\.toml$
^\.Renviron$
^\.Rprofile$
^integration_testing\.R$
^pinsExtras_hex.*\.png$
^\.git$
^\.gitignore$
^\.posit$
^\.claude$
^\.github$
^SECURITY-REVIEW-.*\.local\.md$
# Credential and connection-configuration files. R CMD build does not read
# .gitignore, so these must be listed here too or a developer checkout can
# package them for distribution.
^\.env$
^\.httr-oauth$
^\.secrets$
^.*\.p8$
^.*\.pem$
^.*\.key$
^rsa_key\..*$
^odbc\.ini$
^odbcinst\.ini$
^\.snowflake$
^\.posit$
